{
  // One step, and the chaining lives in an npm script rather than here. VS Code shell tasks
  // fall back to Windows PowerShell 5.1 when pwsh is absent, where `&&` is a parse error;
  // npm runs its scripts through cmd.exe, where it works. Output is revealed, because a build
  // task that shows nothing is indistinguishable from one that did not run.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: sidecar + extension",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:all"],
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": ["$tsc", "$msCompile"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "install: extension dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["install", "--no-audit", "--no-fund"],
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:all"],
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": ["$tsc", "$msCompile"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
