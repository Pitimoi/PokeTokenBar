{
  // No shell chaining anywhere in here. VS Code shell tasks default to Windows PowerShell 5.1
  // when pwsh is absent, and `&&` is a parse error there, so a chained command fails before it
  // runs anything and F5 aborts with nothing useful on screen. Sequencing is expressed with
  // dependsOn instead, which is shell-agnostic.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: sidecar + extension",
      "dependsOrder": "sequence",
      "dependsOn": ["npm: install", "dotnet: build sidecar", "npm: stage and compile"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: install",
      "type": "shell",
      "command": "npm",
      "args": ["install", "--no-audit", "--no-fund"],
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "dotnet: build sidecar",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "-c", "Release", "${workspaceFolder}/dotnet/PokeTokenBar.slnx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // Stages the sidecar into extension/server, then compiles TypeScript. Staging is
      // required: the extension resolves its executable from its own install directory and
      // never from a setting.
      "label": "npm: stage and compile",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "test: dotnet",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/dotnet/PokeTokenBar.slnx"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "group": "test"
    },
    {
      "label": "test: extension",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": ["$tsc"],
      "group": "test"
    }
  ]
}
